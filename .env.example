# Скопируйте в .env и заполните перед `docker compose up -d`.

# Обязательные
BOT_TOKEN=123456:ABC-DEF_ваш_токен_от_BotFather
BOT_USERNAME=enxbot
ENCRYPTION_KEY=длинная-случайная-строка

# Необязательные
# Главный администратор бота (username без @)
ADMIN_USERNAME=
# Базовый адрес для ссылок на веб-страницы бота (нужен для карты точек map.php)
PUBLIC_URL=
# Интервал запуска cron.php, секунды
ENXBOT_CRON_INTERVAL=60
# Сколько секунд тишины в чате до автоматической остановки игры
ENXBOT_IDLE_TIMEOUT=86400
# Таймаут протухания блокировки cron, секунды
ENXBOT_CRON_LOCK_TIMEOUT=300
